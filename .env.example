# ---------------------------------------------------------------------------
# GridMind environment configuration
# Copy to .env and fill in values. The app runs fully with NO keys set
# (AI_PROVIDER=mock is the default) so you can demo GridMind offline.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# SQLite is used by default for local dev. Swap to a Postgres URL for
# production; the ORM layer is Postgres-compatible.
DATABASE_URL=sqlite:///./gridmind.db
# DATABASE_URL=postgresql+psycopg2://gridmind:gridmind@localhost:5432/gridmind

# --- Auth --------------------------------------------------------------------
JWT_SECRET=change-me-in-production-please
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- AI Provider ---------------------------------------------------------------
# One of: mock | anthropic | openai | google
AI_PROVIDER=mock

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- App ----------------------------------------------------------------------
GRIDMIND_ENV=development
CORS_ORIGINS=http://localhost:3000

# --- Frontend (apps/web) -------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
